#!/usr/bin/env bash
# potatoctl — Potato OS management CLI
set -euo pipefail

POTATO_URL="${POTATO_URL:-http://potato.local}"
POTATO_SERVICE="${POTATO_SERVICE:-potato}"

_usage() {
  cat >&2 <<EOF
Usage: potatoctl <command> [args]

Commands:
  doctor              Check Potato OS health (service, API, model)
  logs [api|llm|all]  Stream logs (default: api)
  status              Show raw JSON status from the API
  restart             Restart the potato service
  bench [prompt] [n]  Timed generation + snapshot → Markdown benchmark row
EOF
  exit 1
}

_check() {
  local label="$1" ok="$2" detail="${3:-}"
  if [ "$ok" = "true" ]; then
    printf '  ✓ %s\n' "$label"
  else
    printf '  ✗ %s%s\n' "$label" "${detail:+  ($detail)}"
  fi
}

cmd_doctor() {
  printf 'Potato OS — doctor\n\n'

  # 1. systemd service
  if systemctl is-active --quiet "$POTATO_SERVICE" 2>/dev/null; then
    _check "Service ($POTATO_SERVICE)" true
  else
    _check "Service ($POTATO_SERVICE)" false "run: sudo systemctl start $POTATO_SERVICE"
  fi

  # 2. API reachable
  local status_json
  if status_json="$(curl -sf --max-time 5 "$POTATO_URL/status" 2>/dev/null)"; then
    _check "API ($POTATO_URL/status)" true

    # 3. State
    local state
    state="$(printf '%s' "$status_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('state','?'))" 2>/dev/null || echo '?')"
    if [ "$state" = "READY" ]; then
      _check "State" true "READY"
    else
      _check "State" false "$state"
    fi

    # 4. Model
    local model_filename
    model_filename="$(printf '%s' "$status_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('model',{}).get('filename','none'))" 2>/dev/null || echo 'none')"
    if [ "$model_filename" != "none" ] && [ -n "$model_filename" ]; then
      _check "Model" true "$model_filename"
    else
      _check "Model" false "no model loaded"
    fi

    # 5. Version
    local version
    version="$(printf '%s' "$status_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('update',{}).get('current_version','?'))" 2>/dev/null || echo '?')"
    printf '\n  Version: %s\n' "$version"
  else
    _check "API ($POTATO_URL/status)" false "is potato.local reachable?"
  fi

  printf '\n'
}

cmd_logs() {
  local target="${1:-api}"
  case "$target" in
    api|all)
      exec journalctl -u "$POTATO_SERVICE" -f -n 100
      ;;
    llm)
      exec journalctl -u "$POTATO_SERVICE" -f -n 100 --grep="llama"
      ;;
    model)
      exec journalctl -u "$POTATO_SERVICE" -f -n 100 --grep="model"
      ;;
    *)
      printf 'Unknown log target: %s\nValid: api, llm, model, all\n' "$target" >&2
      exit 1
      ;;
  esac
}

cmd_status() {
  curl -sf "$POTATO_URL/status" | python3 -m json.tool
}

cmd_restart() {
  printf 'Restarting %s...\n' "$POTATO_SERVICE"
  sudo systemctl restart "$POTATO_SERVICE"
  printf 'Done.\n'
}

# Reproducible micro-benchmark: snapshot /status (device, runtime, power,
# temp, throttle) and run one timed generation to measure decode tok/s.
# Prints a human summary plus a ready-to-paste Markdown table row.
cmd_bench() {
  local prompt="${1:-Explain quantum computing in three short sentences.}"
  local max_tokens="${2:-128}"
  python3 - "$POTATO_URL" "$prompt" "$max_tokens" <<'PYEOF'
import json, sys, time, urllib.request

base, prompt, max_tokens = sys.argv[1], sys.argv[2], int(sys.argv[3])

def get_json(url, data=None, timeout=300):
    headers = {"Content-Type": "application/json"} if data else {}
    req = urllib.request.Request(url, data=data, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)

try:
    st = get_json(base + "/status", timeout=5)
except Exception as e:
    sys.exit(f"API unreachable at {base}: {e}")

sysd = st.get("system") or {}
model = (st.get("model") or {}).get("filename") or "?"
runtime = ((st.get("llama_runtime") or {}).get("current") or {}).get("family") or "?"
pi = sysd.get("pi_model_name") or "?"
power = ((sysd.get("power_estimate") or {}).get("adjusted_total_watts"))
temp = sysd.get("temperature_c")
throttle = bool(((sysd.get("throttling") or {}).get("any_current")))

print(f"Model:    {model}")
print(f"Runtime:  {runtime}")
print(f"Device:   {pi}")
print("Running timed generation…")

req = {"model": "local", "stream": False, "temperature": 0.7, "top_p": 0.8,
       "max_tokens": max_tokens,
       "messages": [{"role": "user", "content": prompt}]}
t0 = time.time()
try:
    body = get_json(base + "/v1/chat/completions", data=json.dumps(req).encode())
except Exception as e:
    sys.exit(f"generation failed: {e}")
dt = time.time() - t0

usage = body.get("usage") or {}
ctok = int(usage.get("completion_tokens") or 0)
tps = (ctok / dt) if dt > 0 else 0.0
pw = f"{power:.2f}" if isinstance(power, (int, float)) else "--"
tp = f"{temp:.1f}" if isinstance(temp, (int, float)) else "--"

print()
print(f"Generated {ctok} tokens in {dt:.1f}s → {tps:.2f} tok/s"
      f" | power {pw} W | temp {tp} °C | throttling {'yes' if throttle else 'no'}")
print()
print("Paste into docs/benchmarks (fill quant + notes):")
print("| Model | Quant | Runtime | Gen t/s | Power W | Temp °C | Throttle | Notes |")
print("|-------|-------|---------|---------|---------|---------|----------|-------|")
print(f"| {model} |  | {runtime} | {tps:.2f} | {pw} | {tp} | "
      f"{'yes' if throttle else 'no'} |  |")
PYEOF
}

[ $# -lt 1 ] && _usage

case "$1" in
  doctor)   cmd_doctor ;;
  logs)     cmd_logs "${2:-api}" ;;
  status)   cmd_status ;;
  restart)  cmd_restart ;;
  bench)    cmd_bench "${2:-}" "${3:-128}" ;;
  *)        _usage ;;
esac
